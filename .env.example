# 🔥 FIREBASE CONFIGURATION
# Copie este arquivo para .env e preencha com suas credenciais do Firebase Console
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu_project_id
VITE_FIREBASE_STORAGE_BUCKET=seu_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_messaging_id
VITE_FIREBASE_APP_ID=seu_app_id

# 💳 GOOGLE PLAY IN-APP PURCHASES
# IDs dos produtos configurados no Google Play Console
VITE_IAP_PRODUCT_MONTHLY=granamax_pro_monthly
VITE_IAP_PRODUCT_YEARLY=granamax_pro_yearly
