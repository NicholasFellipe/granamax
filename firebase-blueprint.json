{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado do usuário autenticado do GranaMax",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "ID único do Firebase Auth",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email do usuário",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Nome de exibição da conta Google",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "URL da foto de perfil do Google",
          "maxLength": 512
        },
        "birthDate": {
          "type": "string",
          "description": "Data de nascimento opcional (YYYY-MM-DD)",
          "maxLength": 20
        },
        "isPro": {
          "type": "boolean",
          "description": "Status de assinatura GranaMax PRO"
        },
        "proPlan": {
          "type": "string",
          "enum": ["free", "monthly", "yearly"],
          "description": "Plano ativo da assinatura GranaMax"
        },
        "proActivatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de ativação da assinatura PRO"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação do perfil"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização do perfil"
        }
      },
      "required": ["uid", "email", "isPro", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Receita ou despesa registrada pelo usuário",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID do proprietário da transação",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "description": {
          "type": "string",
          "description": "Descrição da transação",
          "minLength": 1,
          "maxLength": 120
        },
        "amount": {
          "type": "number",
          "description": "Valor positivo em reais"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Tipo da transação"
        },
        "category": {
          "type": "string",
          "description": "Categoria da transação",
          "minLength": 1,
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Data da transação"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        }
      },
      "required": ["userId", "description", "amount", "type", "category", "date", "createdAt"]
    },
    "Investment": {
      "title": "Investment",
      "description": "Ativo de investimento da carteira completa do usuário PRO",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID do proprietário do investimento",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Nome ou ticker do ativo",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": "number",
          "description": "Valor investido inicial"
        },
        "currentValue": {
          "type": "number",
          "description": "Valor atual do ativo"
        },
        "type": {
          "type": "string",
          "enum": ["stocks", "reits", "fixed_income", "funds", "crypto", "savings"],
          "description": "Classe do ativo na carteira"
        },
        "institution": {
          "type": "string",
          "description": "Corretora ou banco onde o ativo está custodiado",
          "maxLength": 80
        },
        "notes": {
          "type": "string",
          "description": "Anotações opcionais sobre tese, vencimento ou rentabilidade",
          "maxLength": 240
        },
        "boughtAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da compra"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização"
        }
      },
      "required": ["userId", "name", "amount", "currentValue", "type", "boughtAt", "updatedAt"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Meta de orçamento mensal de gastos definida pelo usuário",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID do proprietário do orçamento",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "month": {
          "type": "string",
          "description": "Mês de referência no formato YYYY-MM",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "limit": {
          "type": "number",
          "description": "Valor máximo de gastos definido para o mês"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor"
        }
      },
      "required": ["userId", "month", "limit", "createdAt", "updatedAt"]
    },
    "RecurringTransaction": {
      "title": "RecurringTransaction",
      "description": "Conta fixa ou receita recorrente mensal do usuário",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID do proprietário da recorrência",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "description": {
          "type": "string",
          "description": "Descrição da conta ou receita recorrente",
          "minLength": 1,
          "maxLength": 120
        },
        "amount": {
          "type": "number",
          "description": "Valor mensal positivo em reais"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Tipo da recorrência"
        },
        "category": {
          "type": "string",
          "description": "Categoria associada",
          "minLength": 1,
          "maxLength": 40
        },
        "dayOfMonth": {
          "type": "integer",
          "description": "Dia do mês previsto (1 a 31)"
        },
        "active": {
          "type": "boolean",
          "description": "Indica se a recorrência está ativa"
        },
        "lastGeneratedMonth": {
          "type": "string",
          "description": "Último mês (YYYY-MM) em que foi lançada automaticamente, ou vazio",
          "maxLength": 7
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de atualização no servidor"
        }
      },
      "required": [
        "userId",
        "description",
        "amount",
        "type",
        "category",
        "dayOfMonth",
        "active",
        "lastGeneratedMonth",
        "createdAt",
        "updatedAt"
      ]
    },
    "WealthSnapshot": {
      "title": "WealthSnapshot",
      "description": "Marco mensal de evolução patrimonial do usuário PRO",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID do proprietário do marco patrimonial",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "month": {
          "type": "string",
          "description": "Mês de referência no formato YYYY-MM",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "cashBalance": {
          "type": "number",
          "description": "Saldo acumulado em conta no fechamento do marco"
        },
        "investmentsValue": {
          "type": "number",
          "description": "Valor total da carteira de investimentos no marco"
        },
        "netWorth": {
          "type": "number",
          "description": "Patrimônio líquido total (saldo + investimentos)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de atualização no servidor"
        }
      },
      "required": ["userId", "month", "cashBalance", "investmentsValue", "netWorth", "createdAt", "updatedAt"]
    },
    "CustomAlert": {
      "title": "CustomAlert",
      "description": "Regra personalizada de monitoramento financeiro criada pelo usuário",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID do proprietário do alerta",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Nome identificador da regra de alerta",
          "minLength": 1,
          "maxLength": 80
        },
        "metric": {
          "type": "string",
          "enum": ["category_monthly", "min_balance", "single_expense", "portfolio_goal"],
          "description": "Métrica monitorada pela regra"
        },
        "category": {
          "type": "string",
          "description": "Categoria alvo (para regras de limite mensal por categoria)",
          "maxLength": 40
        },
        "threshold": {
          "type": "number",
          "description": "Valor de gatilho positivo em reais"
        },
        "active": {
          "type": "boolean",
          "description": "Indica se a regra está ativa"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de atualização no servidor"
        }
      },
      "required": ["userId", "name", "metric", "category", "threshold", "active", "createdAt", "updatedAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Chamado de suporte prioritário aberto por assinante GranaMax PRO",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID do proprietário do chamado",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "description": "Assunto resumido do chamado",
          "minLength": 1,
          "maxLength": 120
        },
        "topic": {
          "type": "string",
          "enum": ["carteira", "previsoes", "assinatura", "bug", "outro"],
          "description": "Tema do atendimento"
        },
        "priority": {
          "type": "string",
          "enum": ["normal", "high"],
          "description": "Nível de prioridade na fila PRO"
        },
        "message": {
          "type": "string",
          "description": "Descrição detalhada da solicitação",
          "minLength": 1,
          "maxLength": 1500
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_progress", "resolved"],
          "description": "Status atual do atendimento"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de abertura no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor"
        }
      },
      "required": ["userId", "subject", "topic", "priority", "message", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfil privado do usuário contendo email e status PRO"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Transações financeiras pertencentes ao usuário"
    },
    "/investments/{investmentId}": {
      "schema": { "$ref": "#/entities/Investment" },
      "description": "Investimentos registrados na carteira completa do usuário"
    },
    "/monthlyBudgets/{budgetId}": {
      "schema": { "$ref": "#/entities/MonthlyBudget" },
      "description": "Metas mensais de gastos por usuário e mês"
    },
    "/recurringTransactions/{recurringId}": {
      "schema": { "$ref": "#/entities/RecurringTransaction" },
      "description": "Contas fixas e receitas recorrentes mensais por usuário"
    },
    "/wealthSnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/WealthSnapshot" },
      "description": "Marcos mensais de evolução patrimonial por usuário e mês"
    },
    "/customAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/CustomAlert" },
      "description": "Regras personalizadas de alertas financeiros por usuário"
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Chamados da central de suporte prioritário PRO por usuário"
    }
  }
}
